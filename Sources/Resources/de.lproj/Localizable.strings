"whatsNew.v100.baseline.detail" = "Heute misst sich an Ihrem stärksten Tag der letzten dreißig, dieser Monat an denselben Tagen des Vormonats, Gesamt am nächsten Meilenstein. Jede Karte nennt ihren Vergleich. Ein voller Ring heißt: eigener Rekord übertroffen — nie eine Warnung, und hier geht nichts zur Neige.";
"whatsNew.v100.baseline.title" = "Die Bögen bedeuten etwas";
"whatsNew.v100.headline" = "Auf einen Blick: das Wievielfache jedes Abo eingespielt hat";
"whatsNew.v100.local.detail" = "tokscale steckt in der App (MIT) — kein Homebrew, kein npm, kein Node. Vollständig lokal: kein Zugriff auf den Schlüsselbund, keine Passwortabfrage, und nichts verlässt diesen Mac.";
"whatsNew.v100.local.title" = "Nichts zu installieren, nichts geht hinaus";
"whatsNew.v100.makers.detail" = "Dasselbe Modell über verschiedene Wege fällt in eine Zeile zusammen, ein lokal ausgeführtes Qwen bleibt Qwen, und ein über ein Abo abgerechnetes GLM wird niemandem sonst gutgeschrieben.";
"whatsNew.v100.makers.title" = "Gezählt nach dem Hersteller des Modells";
"whatsNew.v100.payback.detail" = "Tragen Sie Preis und Abrechnungstag ein, und die Karte zeigt, um das Wievielfache Ihre Nutzung das Abo zurückgezahlt hat — 13,4× eingespielt oder noch 18 $ bis dahin. Bewertet zu den veröffentlichten API-Preisen und über den tatsächlichen Abrechnungszeitraum gerechnet, nicht über den Kalendermonat.";
"whatsNew.v100.payback.title" = "Hat sich das Abo gelohnt?";
"whatsNew.v100.rings.detail" = "Drei Ringe am Bildschirmrand, darunter die Anzahl der Token. Fahren Sie hin, und die Karte zeigt Gegenwert, das Verhältnis von Ein- und Ausgabe, die Anzahl der Anfragen und die meistgenutzten Modelle.";
"whatsNew.v100.rings.title" = "Heute · Dieser Monat · Gesamt";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen und die übrigen — je einer, alle zunächst aus. Die Liste entsteht aus dem, was dieser Mac tatsächlich ausgeführt hat; ein nie genutzter Anbieter taucht nie auf.";
"whatsNew.v100.vendors.title" = "Ein Ring je Anbieter, nur wo er verdient ist";
