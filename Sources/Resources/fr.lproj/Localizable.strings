"whatsNew.v100.baseline.detail" = "Aujourd'hui se mesure à votre meilleure journée sur trente, ce mois-ci aux mêmes jours du mois dernier, le cumul au prochain palier. Chaque fiche dit à quoi elle se compare. Un anneau complet signifie que vous avez battu votre propre record — jamais un avertissement, et rien ici ne s'épuise.";
"whatsNew.v100.baseline.title" = "Les arcs veulent dire quelque chose";
"whatsNew.v100.headline" = "Ce que chaque abonnement a rapporté, d'un coup d'œil";
"whatsNew.v100.local.detail" = "tokscale est embarqué dans l'app (MIT) — ni Homebrew, ni npm, ni node. Entièrement local : jamais d'accès au trousseau, jamais de mot de passe demandé, et rien ne quitte ce Mac.";
"whatsNew.v100.local.title" = "Rien à installer, rien qui sorte";
"whatsNew.v100.makers.detail" = "Un même modèle appelé par plusieurs voies tient sur une seule ligne, un Qwen exécuté localement reste un Qwen, et un GLM facturé sur un forfait n'est plus crédité à quelqu'un d'autre.";
"whatsNew.v100.makers.title" = "Compté selon qui a conçu le modèle";
"whatsNew.v100.payback.detail" = "Indiquez le prix et le jour de renouvellement, et sa fiche montre combien de fois votre usage l'a remboursé — 13,4× rentabilisé, ou 18 $ à parcourir. Valorisé au tarif public des API et compté sur la période de facturation réelle, pas sur le mois civil.";
"whatsNew.v100.payback.title" = "L'abonnement est-il rentabilisé ?";
"whatsNew.v100.rings.detail" = "Trois anneaux au bord de l'écran, et sous chacun le nombre de tokens. Approchez-vous : la fiche affiche la valeur équivalente, la part d'entrée et de sortie, le nombre de requêtes et les modèles les plus utilisés.";
"whatsNew.v100.rings.title" = "Aujourd'hui · Ce mois-ci · Depuis toujours";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen et les autres — un chacun, tous désactivés au départ. La liste vient de ce que ce Mac a réellement exécuté : un fournisseur jamais utilisé n'apparaît jamais.";
"whatsNew.v100.vendors.title" = "Un anneau par fournisseur, là où il se justifie";
"whatsNew.v110.headline" = "Se tient à jour tout seul, et parle votre langue";
"whatsNew.v110.icon.detail" = "L’icône de l’app existe maintenant avec un cadre sombre ou clair. Choisissez celle qui vous plaît dans Réglages.";
"whatsNew.v110.icon.title" = "Choisissez votre icône";
"whatsNew.v110.languages.detail" = "L’arabe, l’italien, le néerlandais, le polonais, le portugais du Brésil, le turc et le vietnamien rejoignent les neuf déjà présentes, chacune avec sa façon d’écrire les nombres, les montants et les dates.";
"whatsNew.v110.languages.title" = "Seize langues";
"whatsNew.v110.simpler.detail" = "TokNotch s’ouvre désormais tout seul avec votre Mac, et les réglages ne se manifestent que lorsqu’il faut agir.";
"whatsNew.v110.simpler.title" = "Moins de choses à régler";
"whatsNew.v110.updates.detail" = "TokNotch recherche désormais les nouvelles versions et les installe sur place, signées et notarisées par Apple, pour que les chiffres suivent les outils que vous utilisez.";
"whatsNew.v110.updates.title" = "Les mises à jour arrivent seules";
"whatsNew.v120.headline" = "La rentabilité d’un coup d’œil, moins à régler";
"whatsNew.v120.menuBar.detail" = "TokNotch n’occupe plus de place dans le Dock. Son icône dans la barre des menus montre la rentabilité de la période et les tokens du jour d’un coup d’œil.";
"whatsNew.v120.menuBar.title" = "Installé dans la barre des menus";
"whatsNew.v120.payback.detail" = "Chaque fournisseur tient sur une ligne : abonnement, jour de renouvellement, multiple et interrupteur d’anneau. Les détails comme un prix personnalisé n’apparaissent qu’en cas de besoin.";
"whatsNew.v120.payback.title" = "La rentabilité sur une page";
"whatsNew.v120.simpler.detail" = "Les réglages tiennent sur une page : encoche, langue et icône. Le mode masqué disparaît, l’encoche reste toujours à portée.";
