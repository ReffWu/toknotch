"whatsNew.v100.makers.detail" = "Farklı yollardan erişilen aynı model tek satırda birleşir, yerelde çalışan bir Qwen yine Qwen sayılır ve planla ödenen bir GLM artık başkasına yazılmaz.";
"whatsNew.v100.makers.title" = "Modeli kimin yaptığına göre sayılır";
"whatsNew.v100.payback.detail" = "TokNotch’a bir planın ne kadar tuttuğunu ve ne zaman yenilendiğini söyleyin; kartı, kullanımınızın onu kaç kez amorti ettiğini gösterir — 13,4× amorti etti ya da 18 $ kaldı. Aynı işin yayımlanmış API fiyatlarıyla ne tutacağına göre hesaplanır ve takvim ayı yerine gerçek faturalandırma dönemine göre sayılır.";
"whatsNew.v100.payback.title" = "Plan kendini amorti etti mi?";
"whatsNew.v100.rings.detail" = "Ekranın kenarında duran üç halka. Her birinin altında token sayısı var; birine uzanınca kart eşdeğer değeri, girdi ve çıktı dağılımını, istek sayısını ve en çok kullanılan modelleri gösterir.";
"whatsNew.v100.rings.title" = "Bugün · Bu ay · Tüm zamanlar";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen ve diğerleri — her birine bir halka, siz istemeden hepsi kapalı. Liste bu Mac’in gerçekten kullandıklarından oluşur; hiç kullanmadığınız bir şirket asla görünmez.";
